DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-development-only
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Leave DB_ENGINE unset to use SQLite locally.
# Set DB_ENGINE=django.db.backends.postgresql with the values below to use Postgres.
DB_ENGINE=
DB_NAME=stores_inventory_system
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

DJANGO_SUPERUSER_USERNAME=kannde
DJANGO_SUPERUSER_EMAIL=kannde@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-superuser-password
